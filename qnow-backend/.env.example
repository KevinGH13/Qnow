# Neon connection string — format:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Same URL without "-pooler" in the host: used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Auth (Neon Managed Better Auth) — Neon Console → Auth → Configuration → Base URL
NEON_AUTH_BASE_URL=
# Comma-separated. Emails count only when verified; user ids always work.
ALLOWED_EMAILS=
ALLOWED_USER_IDS=
