generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────
// Postgres sorts enums by declaration order: Priority asc => high, medium, low

enum ProjectStatus {
  active
  paused
  closed
}

enum EventStatus {
  scheduled
  completed
}

enum Priority {
  high
  medium
  low
}

enum TaskStatus {
  pending
  in_progress
  done
}

// ─── CORE ENTITIES ────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  events Event[]
  tasks  Task[]
  teams  Team[]

  @@map("projects")
}

model Team {
  id          String  @id @default(cuid())
  projectId   String  @map("project_id")
  name        String
  description String?

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members PersonTeam[]

  @@map("teams")
}

model Person {
  id          String  @id @default(cuid())
  name        String
  email       String? @unique // optional; Postgres allows many NULLs under UNIQUE
  role        String?
  description String?

  teams  PersonTeam[]
  events EventParticipant[]

  @@map("people")
}

model Event {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  title       String
  description String?
  date        DateTime
  status      EventStatus @default(scheduled)
  createdAt   DateTime    @default(now()) @map("created_at")

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisions    Decision[]
  tasks        Task[]
  participants EventParticipant[]

  @@index([projectId, date])
  @@map("events")
}

model Decision {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  text      String
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tags  DecisionTag[]

  @@map("decisions")
}

model Task {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  eventId   String?    @map("event_id")
  text      String
  priority  Priority   @default(medium)
  status    TaskStatus @default(pending)
  createdAt DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([projectId, priority, createdAt])
  @@map("tasks")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  decisions DecisionTag[]

  @@map("tags")
}

// ─── JOIN TABLES ──────────────────────────────────────────

model PersonTeam {
  personId String @map("person_id")
  teamId   String @map("team_id")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([personId, teamId])
  @@map("person_team")
}

model EventParticipant {
  eventId  String @map("event_id")
  personId String @map("person_id")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@map("event_participant")
}

model DecisionTag {
  decisionId String @map("decision_id")
  tagId      String @map("tag_id")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([decisionId, tagId])
  @@map("decision_tag")
}
